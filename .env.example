# Plantilla del archivo .env del servidor. Cópiala a .env (cp .env.example .env), rellénala y protégela (chmod 600 .env).
# El .env NUNCA se sube a GitHub (está en .gitignore). Guarda una copia de los valores en tu gestor de contraseñas.
# Sin comillas y sin espacios alrededor del "=". Después de cambiarlo: docker compose up -d (no "restart": no relee el .env).
# Paso a paso de dónde sale cada valor: docs/manual-instalacion.md.

# --- Dirección pública (Tailscale Funnel), con https:// y barra final. Ejemplo: https://secretaria.tu-red.ts.net/
N8N_WEBHOOK_URL=

# --- WhatsApp (SECRETOS) ---
# App Secret de tu app de Meta (Configuración de la app > Básica > Clave secreta de la app)
WHATSAPP_APP_SECRET=
# Contraseña del webhook que inventas tú (una cadena larga y aleatoria; la misma que pongas en Meta al registrar el webhook)
WHATSAPP_VERIFY_TOKEN=
# Tu número de móvil, el ÚNICO que puede hablar con la secretaria: prefijo del país y número, solo dígitos (ejemplo: 34600111222)
WHATSAPP_NUMERO_PERMITIDO=

# --- Identificadores (no son secretos, pero tampoco hace falta publicarlos) ---
# Project URL de Supabase, sin /rest/v1 (ejemplo: https://abcdefghijklmnop.supabase.co)
SUPABASE_URL=
# Identificador del número de teléfono de WhatsApp (Meta > WhatsApp > Configuración de la API > Phone number ID), solo dígitos
WHATSAPP_PHONE_NUMBER_ID=
# ID del calendario "Secretaria" de Google Calendar (Configuración del calendario > Integrar el calendario > ID del calendario)
GOOGLE_CALENDAR_ID=
# ID de la carpeta "Secretaria" de Google Drive (el último trozo de su URL)
DRIVE_CARPETA_RAIZ_ID=
# ID de la carpeta "Secretaria/Entrada" de Google Drive (el último trozo de su URL)
DRIVE_ENTRADA_ID=

# --- Monitor externo (opcional, recomendado): dirección del check "n8n-latido" de Healthchecks.io (es privada)
HEALTHCHECK_URL_N8N=
